[Unit]
Description=FileDock Management Service
After=network-online.target filedock-core.socket
Wants=network-online.target filedock-core.socket

[Service]
Type=simple
User=filedock-mgmt
Group=filedock-mgmt
WorkingDirectory=/usr/lib/filedock/management
EnvironmentFile=/etc/filedock/management.env
ExecStart=/usr/lib/filedock/filedock-management
Restart=on-failure
RestartSec=2
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StateDirectory=filedock-management
UMask=0077

[Install]
WantedBy=multi-user.target
