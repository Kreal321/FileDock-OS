[Unit]
Description=FileDock Management Service
After=network-online.target filedock-core.socket filedock-runtime.service
Requires=filedock-runtime.service
Wants=network-online.target filedock-core.socket

[Service]
Type=simple
User=filedock-mgmt
Group=filedock-mgmt
WorkingDirectory=/usr/lib/filedock/management
EnvironmentFile=/etc/filedock/management.env
ExecStartPre=+/usr/bin/install -d -o root -g filedock-mgmt -m 0770 /run/filedock
ExecStart=/usr/lib/filedock/filedock-management
Restart=on-failure
RestartSec=2
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/filedock /var/lib/filedock/extensions/inbox
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=filedock-management
UMask=0077

[Install]
WantedBy=multi-user.target
