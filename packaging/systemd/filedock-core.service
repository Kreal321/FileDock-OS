[Unit]
Description=FileDock Core Service
After=network-online.target filedock-core.socket
Requires=filedock-core.socket
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/filedock/filedock-core
Restart=on-failure
RestartSec=2
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StateDirectory=filedock-core filedock

[Install]
WantedBy=multi-user.target
Also=filedock-core.socket
