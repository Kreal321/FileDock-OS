<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FileDock.Management.Core</RootNamespace>
    <ProtoRoot>$(MSBuildThisFileDirectory)..\..\..\proto</ProtoRoot>
    <!-- Generated gRPC stubs use proto package `filedock.core.v1` → `Filedock.Core.V1`. -->
    <NoWarn>$(NoWarn);CA1708</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\filedock\core\v1\core.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Client" Access="Public" />
  </ItemGroup>

</Project>
